<?xml version="1.0" encoding="UTF-8"?>
<root name="payment-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <user_account _name="Customer Account"
                _module="Core"
                _module_key="core"
                user_id="U-987654321"
                user_name="boolean()"
                _audit_mask_fields="user_name"
                create_time="createTime()"
                update_time="updateTime()"/>

  <payment_account _name="Payment Account"
                   _module="Core"
                   _module_key="core"
                   user_account="user_account()"
                   account_name="Main Corporate Account"
                   account_number="1234567890"
                   currency_code="USD"
                   _audit_mask_fields="account_number,account_name"
                   create_time="createTime()"
                   update_time="updateTime()"/>

  <payment_method _name="Payment Method"
                  _module="Core"
                  _module_key="core"
                  payment_account="payment_account()"
                  method_type="CREDIT_CARD"
                  last_four_digits="4242"
                  _audit_mask_fields="payment_account,last_four_digits"
                  create_time="createTime()"
                  update_time="updateTime()"/>



  <payment_transaction _name="Payment Transaction"
                       _module="Core"
                       _module_key="core"
                       payment_account="payment_account()"
                       currency_code="USD"
                       payment_method="payment_method()"
                       transaction_amount="150.00"
                       _audit_mask_fields="payment_account"
                       create_time="createTime()"
                       update_time="updateTime()"/>
</root>
