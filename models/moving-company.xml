<?xml version="1.0" encoding="UTF-8"?>
<root name="moving-company-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">

  <company _name="Moving Company"
           _module="Organization"
           _module_key="organization"
           name="Swift Movers LLC"
           address="123 Logistics Ave, Springfield, IL 62701"
           phone="555-0100"
           email="info@swiftmovers.example.com"
           create_time="createTime()"
           update_time="updateTime()"/>

  <customer _name="Customer"
            _module="Clients"
            _module_key="clients"
            company="company()"
            full_name="Jane Doe"
            email="jane.doe@example.com"
            phone="555-0201"
            address="456 Oak Street, Springfield, IL 62702"
            password_hash="hashed_secret_value"
            create_time="createTime()"
            update_time="updateTime()"
            _audit_mask_fields="password_hash,email,phone,address,full_name"/>

  <driver _name="Driver"
          _module="Operations"
          _module_key="operations"
          company="company()"
          full_name="John Smith"
          email="john.smith@swiftmovers.example.com"
          phone="555-0301"
          license_number="IL-DRV-12345"
          password_hash="hashed_driver_secret"
          create_time="createTime()"
          update_time="updateTime()"
          _audit_mask_fields="password_hash,email,phone,full_name"/>

  <vehicle _name="Vehicle"
           _module="Operations"
           _module_key="operations"
           company="company()"
           plate_number="IL-MV-1234"
           vehicle_type="box truck"
           capacity_cubic_feet="1200"
           is_available="true"
           create_time="createTime()"
           update_time="updateTime()"/>

  <move_order_status _name="Move Order Status"
                     _module="Operations"
                     _module_key="operations"
                     company="company()"
                     id="id()"
                     name="string()"
                     code="string()"
                     color="string()"
                     display_order="number()"
                     progress="number()"
                     _constant="true"
                     _identifier="code">
    <_value id="1001" name="Pending" code="PENDING"
            color="#F59E0B" display_order="1" progress="5"/>
    <_value id="1002" name="Confirmed" code="CONFIRMED"
            color="#2563EB" display_order="2" progress="20"/>
    <_value id="1003" name="Assigned" code="ASSIGNED"
            color="#7C3AED" display_order="3" progress="40"/>
    <_value id="1004" name="In Transit" code="IN_TRANSIT"
            color="#EA580C" display_order="4" progress="70"/>
    <_value id="1005" name="Delivered" code="DELIVERED"
            color="#16A34A" display_order="5" progress="100"/>
    <_value id="1006" name="Cancelled" code="CANCELLED"
            color="#6B7280" display_order="6" progress="1"/>
  </move_order_status>

  <move_order _name="Move Order"
              _module="Operations"
              _module_key="operations"
              company="company()"
              customer="customer()"
              driver="driver()"
              vehicle="vehicle()"
              status="move_order_status()"
              origin_address="456 Oak Street, Springfield, IL 62702"
              destination_address="789 Pine Avenue, Chicago, IL 60601"
              scheduled_date="2025-08-15"
              estimated_hours="6"
              special_instructions="Piano requires special handling"
              create_time="createTime()"
              update_time="updateTime()"/>

  <invoice _name="Invoice"
           _module="Operations"
           _module_key="operations"
           company="company()"
           move_order="move_order()"
           customer="customer()"
           invoice_number="INV-2025-0001"
           total_amount="1500.00"
           paid_amount="0.00"
           is_paid="false"
           due_date="2025-09-15"
           create_time="createTime()"
           update_time="updateTime()"/>

  <review _name="Review"
          _module="Operations"
          _module_key="operations"
          company="company()"
          move_order="move_order()"
          customer="customer()"
          rating="5"
          comment="Excellent service, very careful with our belongings!"
          create_time="createTime()"
          update_time="updateTime()"/>

</root>
